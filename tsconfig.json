  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/shared" },
    { "path": "./apps/electron" }
  ]
}
